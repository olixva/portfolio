{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "antoniooliva.com", "custom_domain": true },
    { "pattern": "www.antoniooliva.com", "custom_domain": true }
  ]
}
